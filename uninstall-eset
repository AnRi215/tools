<#
.SYNOPSIS
    Unterstützt bei der Deinstallation von ESET-Produkten.
.DESCRIPTION
    Sichert die aktuelle Netzwerkadapter-Konfiguration nach C:\NetworkSettings.txt,
    lädt den ESET-Uninstaller herunter, aktiviert den abgesicherten Start mit
    Netzwerktreibern und startet den Host nach Bestätigung eines Countdowns neu.
    Legt zusätzlich eine Desktop-Verknüpfung an, mit der sich der abgesicherte
    Start später wieder deaktivieren lässt.
.USAGE
    irm "https://tools.anri.sh/uninstall-eset" | iex
#>

Set-StrictMode -Off
$ErrorActionPreference = "Stop"

# ─── Hilfsfunktion: abbrechbarer Countdown ─────────────────────────────────

function Start-CancellableCountdown {
    param(
        [int]$Seconds,
        [string]$Label = "Neustart"
    )

    while ([Console]::KeyAvailable) { [Console]::ReadKey($true) | Out-Null }

    Write-Host ""
    Write-Host "$Label in $Seconds Sekunden. Beliebige Taste zum Abbrechen drücken." -ForegroundColor Yellow

    for ($i = $Seconds; $i -gt 0; $i--) {
        Write-Host "`r$Label in $i Sekunden...   " -NoNewline -ForegroundColor Yellow
        $Elapsed = 0
        while ($Elapsed -lt 1000) {
            if ([Console]::KeyAvailable) {
                [Console]::ReadKey($true) | Out-Null
                Write-Host ""
                Write-Host "Abgebrochen." -ForegroundColor Red
                return $false
            }
            Start-Sleep -Milliseconds 100
            $Elapsed += 100
        }
    }

    Write-Host ""
    return $true
}

# ─── Admin-Check ────────────────────────────────────────────────────────────

$CurrentIdentity = [Security.Principal.WindowsIdentity]::GetCurrent()
$CurrentPrincipal = New-Object Security.Principal.WindowsPrincipal($CurrentIdentity)
$IsAdmin = $CurrentPrincipal.IsInRole([Security.Principal.WindowsBuiltInRole]::Administrator)

if (-not $IsAdmin) {
    Write-Host ""
    Write-Host "Dieses Skript benötigt Administratorrechte." -ForegroundColor Red
    Write-Host "Bitte PowerShell als Administrator erneut starten." -ForegroundColor Red
    Write-Host ""
    return
}

# ─── Hinweis ────────────────────────────────────────────────────────────────

Write-Host ""
Write-Host "Dieses Skript dient zur Unterstützung bei der Deinstallation von ESET-Produkten." -ForegroundColor Cyan
Write-Host ""

# ─── Bestätigung ────────────────────────────────────────────────────────────

$Confirm = Read-Host "Bestätige um fortzufahren. Anschließend wird die Konfiguration der Netzwerkadapter unter 'C:\NetworkSettings.txt' gesichert und der Host wird in den abgesicherten Modus gestartet (n/y)"

if ($Confirm -notmatch "^[yY]$") {
    Write-Host ""
    Write-Host "Abgebrochen." -ForegroundColor Yellow
    Write-Host ""
    return
}

# ─── ESET-Uninstaller herunterladen ────────────────────────────────────────

Write-Host ""
Write-Host "ESET-Uninstaller wird heruntergeladen..." -ForegroundColor Cyan

$UninstallerPath = "$env:USERPROFILE\Downloads\eset-uninstaller.exe"

Invoke-WebRequest -Uri "https://download.eset.com/com/eset/tools/installers/eset_apps_remover/latest/uninstaller.exe" `
    -OutFile $UninstallerPath

# ─── Netzwerkkonfiguration sichern ─────────────────────────────────────────

Write-Host "Netzwerkkonfiguration wird gesichert..." -ForegroundColor Cyan

$NetworkSettingsPath = "C:\NetworkSettings.txt"
netsh -c interface dump | Out-File -FilePath $NetworkSettingsPath -Encoding utf8

# ─── Abgesicherten Start mit Netzwerk aktivieren ───────────────────────────

Write-Host "Abgesicherter Start mit Netzwerktreibern wird aktiviert..." -ForegroundColor Cyan

bcdedit /set '{current}' safeboot network | Out-Null

# ─── Validierung ────────────────────────────────────────────────────────────

$NetworkOk  = (Test-Path $NetworkSettingsPath) -and ((Get-Item $NetworkSettingsPath).Length -gt 0)
$DownloadOk = Test-Path $UninstallerPath
$SafeModeOk = ((bcdedit /enum '{current}') -join "`n") -match "safeboot"

Write-Host ""
Write-Host "Validierung:" -ForegroundColor Cyan
Write-Host "  [$(if ($NetworkOk)  {'x'} else {' '})] Netzwerkkonfiguration gesichert ($NetworkSettingsPath)" -ForegroundColor $(if ($NetworkOk)  {'Green'} else {'Red'})
Write-Host "  [$(if ($DownloadOk) {'x'} else {' '})] ESET-Uninstaller heruntergeladen ($UninstallerPath)"    -ForegroundColor $(if ($DownloadOk) {'Green'} else {'Red'})
Write-Host "  [$(if ($SafeModeOk) {'x'} else {' '})] Abgesicherter Start (Netzwerk) aktiviert"                -ForegroundColor $(if ($SafeModeOk) {'Green'} else {'Red'})
Write-Host ""

if (-not ($NetworkOk -and $DownloadOk -and $SafeModeOk)) {
    Write-Host "Mindestens ein Schritt ist fehlgeschlagen. Neustart wird nicht ausgeführt." -ForegroundColor Red
    Write-Host ""
    return
}

# ─── Desktop-Verknüpfung zum Beenden des abgesicherten Starts anlegen ──────

$DesktopPath  = [Environment]::GetFolderPath('Desktop')
$ShortcutPath = Join-Path $DesktopPath "Abgesicherten Modus beenden.lnk"

$RevertScript = @'
$ErrorActionPreference = "SilentlyContinue"

bcdedit /deletevalue '{current}' safeboot | Out-Null

Write-Host ""
Write-Host "Abgesicherter Start wurde deaktiviert." -ForegroundColor Cyan

while ([Console]::KeyAvailable) { [Console]::ReadKey($true) | Out-Null }

$Cancelled = $false
Write-Host "Neustart in 10 Sekunden. Beliebige Taste zum Abbrechen drücken." -ForegroundColor Yellow
for ($i = 10; $i -gt 0; $i--) {
    Write-Host "`rNeustart in $i Sekunden...   " -NoNewline -ForegroundColor Yellow
    $Elapsed = 0
    while ($Elapsed -lt 1000) {
        if ([Console]::KeyAvailable) {
            [Console]::ReadKey($true) | Out-Null
            $Cancelled = $true
            break
        }
        Start-Sleep -Milliseconds 100
        $Elapsed += 100
    }
    if ($Cancelled) { break }
}
Write-Host ""

if ($Cancelled) {
    Write-Host "Abgebrochen." -ForegroundColor Red
} else {
    Remove-Item -Path "__SHORTCUT_PATH__" -Force -ErrorAction SilentlyContinue
    Restart-Computer -Force
}
'@

$RevertScript = $RevertScript.Replace("__SHORTCUT_PATH__", $ShortcutPath)
$EncodedRevertCommand = [Convert]::ToBase64String([Text.Encoding]::Unicode.GetBytes($RevertScript))

$WScriptShell = New-Object -ComObject WScript.Shell
$Shortcut = $WScriptShell.CreateShortcut($ShortcutPath)
$Shortcut.TargetPath = "powershell.exe"
$Shortcut.Arguments = "-NoProfile -ExecutionPolicy Bypass -WindowStyle Normal -EncodedCommand $EncodedRevertCommand"
$Shortcut.WorkingDirectory = $DesktopPath
$Shortcut.Description = "Deaktiviert den abgesicherten Start und startet neu"
$Shortcut.Save()

Write-Host "Verknüpfung ""Abgesicherten Modus beenden"" wurde auf dem Desktop angelegt." -ForegroundColor Cyan

# ─── Neustart (abbrechbar) ─────────────────────────────────────────────────

$Proceed = Start-CancellableCountdown -Seconds 10 -Label "Neustart"

if ($Proceed) {
    Restart-Computer -Force
} else {
    Write-Host "Der abgesicherte Start bleibt aktiviert. Neustart wurde nicht ausgeführt." -ForegroundColor Yellow
    Write-Host ""
}
