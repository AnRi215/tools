<#
.SYNOPSIS
    Unterstützt bei der Deinstallation von ESET-Produkten.
.DESCRIPTION
    Sichert die aktuelle Netzwerkadapter-Konfiguration nach C:\NetworkSettings.txt,
    aktiviert den abgesicherten Start mit Netzwerktreibern und startet den Host
    nach 10 Sekunden neu.
.USAGE
    irm "https://tools.anri.sh/uninstall-eset" | iex
#>

Set-StrictMode -Off
$ErrorActionPreference = "Stop"

# ─── Admin-Check ────────────────────────────────────────────────────────────

$CurrentIdentity = [Security.Principal.WindowsIdentity]::GetCurrent()
$CurrentPrincipal = New-Object Security.Principal.WindowsPrincipal($CurrentIdentity)
$IsAdmin = $CurrentPrincipal.IsInRole([Security.Principal.WindowsBuiltInRole]::Administrator)

if (-not $IsAdmin) {
    Write-Host ""
    Write-Host "Dieses Skript benötigt Administratorrechte." -ForegroundColor Red
    Write-Host "Bitte PowerShell als Administrator erneut starten." -ForegroundColor Red
    Write-Host ""
    return
}

# ─── Hinweis ────────────────────────────────────────────────────────────────

Write-Host ""
Write-Host "Dieses Skript dient zur Unterstützung bei der Deinstallation von ESET-Produkten." -ForegroundColor Cyan
Write-Host ""

# ─── Bestätigung ────────────────────────────────────────────────────────────

$Confirm = Read-Host "Bestätige um fortzufahren. Anschließend wird die Konfiguration der Netzwerkadapter unter 'C:\NetworkSettings.txt' gesichert und der Host wird in den abgesicherten Modus gestartet (y/n)"

if ($Confirm -notmatch "^[yY]$") {
    Write-Host ""
    Write-Host "Abgebrochen." -ForegroundColor Yellow
    Write-Host ""
    return
}

# ─── ESET-Uninstaller herunterladen ────────────────────────────────────────

Write-Host ""
Write-Host "ESET-Uninstaller wird heruntergeladen..." -ForegroundColor Cyan

Invoke-WebRequest -Uri "https://download.eset.com/com/eset/tools/installers/eset_apps_remover/latest/uninstaller.exe" `
    -OutFile "$env:USERPROFILE\Desktop\uninstall-eset.exe"

Write-Host "Download abgeschlossen: $env:USERPROFILE\Desktop\uninstall-eset.exe" -ForegroundColor Cyan

# ─── Netzwerkkonfiguration sichern (Hintergrund) ───────────────────────────

Start-Process -FilePath "cmd.exe" `
    -ArgumentList "/c netsh -c interface dump > C:\NetworkSettings.txt" `
    -WindowStyle Hidden

Write-Host ""
Write-Host "Netzwerkkonfiguration wird gesichert..." -ForegroundColor Cyan

# ─── Abgesicherten Start mit Netzwerk aktivieren + Neustart in 10s (Hintergrund) ─

$RestartCommand = "bcdedit /set {current} safeboot network; Start-Sleep -Seconds 10; Restart-Computer -Force"

Start-Process -FilePath "powershell.exe" `
    -ArgumentList "-NoProfile", "-WindowStyle", "Hidden", "-Command", $RestartCommand `
    -WindowStyle Hidden

Write-Host "Abgesicherter Start mit Netzwerktreibern wurde aktiviert." -ForegroundColor Cyan
Write-Host "Der Host wird in 10 Sekunden neu gestartet." -ForegroundColor Yellow
Write-Host ""
