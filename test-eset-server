function Test-TcpConnection {
    param(
        [string]$Hostname,
        [int]$Port,
        [int]$TimeoutMs
    )

    $resolvedIP = $null
    $success    = $false

    try {
        # DNS-Auflösung vorab, um die IP für die Ausgabe zu ermitteln
        $dnsResult  = [System.Net.Dns]::GetHostAddresses($Hostname)
        $resolvedIP = $dnsResult[0].IPAddressToString
    } catch {
        $resolvedIP = "n/a (DNS-Fehler)"
        return [PSCustomObject]@{ Success = $false; IP = $resolvedIP }
    }

    $client = [System.Net.Sockets.TcpClient]::new()
    try {
        $asyncResult = $client.BeginConnect($Hostname, $Port, $null, $null)
        $waited      = $asyncResult.AsyncWaitHandle.WaitOne($TimeoutMs, $false)

        if ($waited -and $client.Connected) {
            $success = $true
            $client.EndConnect($asyncResult)
        }
        # Falls $waited = $false → Timeout abgelaufen → $success bleibt $false
    } catch {
        # Verbindung aktiv abgelehnt → ebenfalls FAIL
        $success = $false
    } finally {
        $client.Close()
    }

    return [PSCustomObject]@{ Success = $success; IP = $resolvedIP }
}

Write-Host "`nESET Connectivity Check - $(Get-Date -Format 'yyyy-MM-dd HH:mm:ss')" -ForegroundColor Cyan
Write-Host ("=" * 75) -ForegroundColor Cyan

$total   = $tests.Count
$current = 0

foreach ($entry in $tests) {
    $current++
    Write-Progress -Activity "Teste ESET-Konnektivität..." `
                   -Status "$($entry.h):$($entry.p)" `
                   -PercentComplete (($current / $total) * 100)

    $result = Test-TcpConnection -Hostname $entry.h -Port $entry.p -TimeoutMs $TIMEOUT_MS

    $results += [PSCustomObject]@{
        Category         = $entry.c
        Host             = $entry.h
        Port             = $entry.p
        IP               = $result.IP
        TcpTestSucceeded = $result.Success
    }
}

Write-Progress -Completed -Activity "Fertig"

$categories = $results | Select-Object -ExpandProperty Category -Unique

foreach ($cat in $categories) {
    Write-Host "`n[ $cat ]" -ForegroundColor Yellow
    $catResults = $results | Where-Object { $_.Category -eq $cat }
    foreach ($row in $catResults) {
        $status = if ($row.TcpTestSucceeded) { "OK  " } else { "FAIL" }
        $color  = if ($row.TcpTestSucceeded) { "Green" } else { "Red" }
        Write-Host ("  [$status]  {0,-35} Port {1,-6}  IP: {2}" -f $row.Host, $row.Port, $row.IP) -ForegroundColor $color
    }
}

$passed = ($results | Where-Object {  $_.TcpTestSucceeded }).Count
$failed = ($results | Where-Object { -not $_.TcpTestSucceeded }).Count

Write-Host "`n$('=' * 75)" -ForegroundColor Cyan

$summaryColor = if ($failed -eq 0) { "Green" } else { "Yellow" }
Write-Host ("Ergebnis: {0} von {1} Tests erfolgreich  |  {2} fehlgeschlagen" -f $passed, $total, $failed) -ForegroundColor $summaryColor

if ($failed -gt 0) {
    Write-Host "`nFehlgeschlagene Verbindungen:" -ForegroundColor Red
    $results | Where-Object { -not $_.TcpTestSucceeded } | Format-Table Category, Host, Port -AutoSize
}

Write-Host ""
Write-Host "  Vielen Dank für die Nutzung!" -ForegroundColor Green
Write-Host "  Weitere Informationen auf github.com/anri215/tools" -ForegroundColor Green
Write-Host ""
